<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.orders.PlaceOrderFXController" fx:id="ordersPage"
            fitToWidth="true" styleClass="page-scroll" stylesheets="@../css/orders.css"
            accessibleText="Place Order workspace">
    <content>
        <StackPane alignment="TOP_CENTER">
            <VBox maxWidth="1280" minHeight="-Infinity" styleClass="page, section">
                <VBox spacing="8">
                    <Label text="Place Order" styleClass="page-heading" />
                    <Label text="A thoughtful selection, made yours." styleClass="page-subtitle" wrapText="true" />
                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <Label fx:id="sessionStatus" text="Loading demonstration session..." styleClass="helper-text"
                               wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" />
                        <ProgressIndicator fx:id="processing" prefWidth="24" prefHeight="24" maxWidth="24"
                                           maxHeight="24" visible="false" managed="false" styleClass="orders-progress" />
                        <Button fx:id="reloadButton" text="Reload" onAction="#reload" styleClass="button-secondary" />
                    </HBox>
                </VBox>

                <VBox styleClass="dashboard-card">
                    <Label text="Fragrance catalog" styleClass="section-heading" />
                    <TableView fx:id="catalogTable" minHeight="188" prefHeight="188" maxHeight="188" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="catalogName" text="Product" minWidth="140" prefWidth="220" />
                            <TableColumn fx:id="catalogCategory" text="Category" minWidth="110" prefWidth="150" />
                            <TableColumn fx:id="catalogPrice" text="Unit price" minWidth="90" prefWidth="110" />
                            <TableColumn fx:id="catalogStock" text="Available stock" minWidth="128" prefWidth="140" />
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" styleClass="empty-state">
                                <Label text="Catalog unavailable" styleClass="empty-state-title" />
                                <Label text="Reload to retrieve products and current availability." styleClass="helper-text" wrapText="true" />
                            </VBox>
                        </placeholder>
                    </TableView>
                    <HBox alignment="BOTTOM_LEFT" spacing="16">
                        <VBox minWidth="0" HBox.hgrow="ALWAYS" styleClass="orders-fields">
                            <Label text="Selected product" styleClass="field-label" />
                            <Label fx:id="selectedCatalogProduct" text="Select a product" wrapText="true" minHeight="44" />
                        </VBox>
                        <VBox prefWidth="100" minWidth="80" styleClass="orders-fields">
                            <Label text="Quantity" labelFor="${addQuantity}" styleClass="field-label" />
                            <TextField fx:id="addQuantity" text="1" styleClass="form-field" />
                        </VBox>
                        <Button fx:id="addButton" text="Add to Cart" onAction="#addToCart" styleClass="button-primary" disable="true" />
                    </HBox>
                    <Label fx:id="cartCount" text="Cart is empty" styleClass="helper-text" />
                </VBox>

                <VBox styleClass="dashboard-card">
                    <Label text="Shopping cart" styleClass="section-heading" />
                    <TableView fx:id="cartTable" minHeight="232" prefHeight="232" maxHeight="232"
                               styleClass="data-table, orders-cart-table">
                        <columns>
                            <TableColumn fx:id="cartName" text="Product" minWidth="120" prefWidth="190" />
                            <TableColumn fx:id="cartQuantity" text="Quantity" minWidth="166" prefWidth="166" sortable="false" />
                            <TableColumn fx:id="cartPrice" text="Unit price" minWidth="90" prefWidth="100" />
                            <TableColumn fx:id="cartTotal" text="Line total" minWidth="90" prefWidth="110" />
                            <TableColumn fx:id="cartRemove" text="Actions" minWidth="90" prefWidth="90" sortable="false" />
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" styleClass="empty-state">
                                <Label text="Your cart is empty" styleClass="empty-state-title" />
                                <Label text="Select a fragrance above and add a quantity to begin." styleClass="helper-text" wrapText="true" />
                            </VBox>
                        </placeholder>
                    </TableView>
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label text="Cart subtotal (estimate)" styleClass="field-label" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="cartSubtotal" text="0.00" styleClass="orders-total" />
                    </HBox>
                    <Label text="Update quantity edits before previewing. Loyalty discounts are calculated in the order preview."
                           styleClass="helper-text" wrapText="true" minHeight="-Infinity" />
                </VBox>

                <VBox styleClass="dashboard-card">
                    <Label text="Customer &amp; fulfillment" styleClass="section-heading" />
                    <VBox styleClass="orders-fields">
                        <Label text="Customer" labelFor="${customerChoice}" styleClass="field-label" />
                        <ComboBox fx:id="customerChoice" promptText="Choose an existing customer" maxWidth="Infinity" styleClass="form-combo" />
                    </VBox>
                    <Label fx:id="customerDetails" text="Select an existing customer." styleClass="helper-text" wrapText="true" />
                    <Label fx:id="availablePoints" text="Available loyalty points: Unavailable" styleClass="field-label" />
                    <HBox spacing="16">
                        <VBox minWidth="0" HBox.hgrow="ALWAYS" styleClass="orders-fields">
                            <Label text="Points to redeem" labelFor="${pointsToRedeem}" styleClass="field-label" />
                            <TextField fx:id="pointsToRedeem" text="0" styleClass="form-field" />
                        </VBox>
                        <VBox minWidth="180" HBox.hgrow="ALWAYS" styleClass="orders-fields">
                            <Label text="Fulfillment" labelFor="${fulfillmentChoice}" styleClass="field-label" />
                            <ComboBox fx:id="fulfillmentChoice" promptText="Choose fulfillment" maxWidth="Infinity" styleClass="form-combo" />
                        </VBox>
                    </HBox>
                    <Label fx:id="pointsValidation" text="Enter nonnegative whole loyalty points."
                           visible="false" managed="false" styleClass="validation-message" wrapText="true" />
                </VBox>

                <VBox styleClass="dashboard-card">
                    <Label text="Order summary" styleClass="section-heading" />
                    <Label fx:id="previewStatus" text="Preview required for the current selections"
                           styleClass="helper-text" wrapText="true" minHeight="-Infinity" />
                    <Label fx:id="confirmationLabel" visible="false" managed="false" wrapText="true"
                           minHeight="-Infinity" styleClass="field-label" />
                    <GridPane styleClass="orders-quote-grid">
                        <Label text="Subtotal" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="quoteSubtotal" text="&#8212;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label text="Loyalty discount" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="quoteDiscount" text="&#8212;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Final total" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="quoteTotal" text="&#8212;" styleClass="orders-total" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label text="Points to redeem" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <Label fx:id="quotePoints" text="&#8212;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label text="Fulfillment" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <Label fx:id="quoteFulfillment" text="&#8212;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    </GridPane>
                    <HBox alignment="CENTER_RIGHT" spacing="16">
                        <Button fx:id="previewButton" text="Preview Order" onAction="#preview" disable="true" styleClass="button-secondary" />
                        <Button fx:id="confirmButton" text="Confirm Order" onAction="#confirm" disable="true" styleClass="button-primary" />
                    </HBox>
                </VBox>
                <Label fx:id="feedback" visible="false" managed="false" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" />
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
