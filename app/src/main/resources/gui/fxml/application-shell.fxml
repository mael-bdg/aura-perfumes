<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.navigation.ApplicationShellController"
            styleClass="app-background">
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT">
                <padding><Insets top="24" right="32" bottom="24" left="32" /></padding>
                <Label text="AURA PERFUMES" styleClass="brand" />
            </HBox>
            <Separator styleClass="section-separator" />
        </VBox>
    </top>
    <left>
        <VBox minWidth="232" prefWidth="232" maxWidth="232" styleClass="section, surface-background">
            <padding><Insets top="24" right="16" bottom="24" left="16" /></padding>
            <Button fx:id="homeButton" text="Home" onAction="#showHome"
                          maxWidth="Infinity" styleClass="button-navigation" />
            <Button fx:id="stockButton" text="Stock Management" onAction="#showStock"
                          maxWidth="Infinity" styleClass="button-navigation" />
            <Button fx:id="ordersButton" text="Place Order" onAction="#showOrders"
                          maxWidth="Infinity" styleClass="button-navigation" />
            <Button fx:id="consultationButton" text="Consultations" onAction="#showConsultations"
                          maxWidth="Infinity" styleClass="button-navigation" />
            <Button fx:id="boutiqueButton" text="Boutique Orders" onAction="#showBoutiqueOrders"
                          maxWidth="Infinity" styleClass="button-navigation" />
        </VBox>
    </left>
    <center>
        <BorderPane fx:id="contentContainer" />
    </center>
    <bottom>
        <VBox>
            <Separator styleClass="section-separator" />
            <HBox alignment="CENTER_LEFT">
                <padding><Insets top="16" right="32" bottom="16" left="32" /></padding>
                <Label text="CRAFTED WITH CARE" styleClass="helper-text" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Aura Perfumes - Desktop Application" styleClass="helper-text" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
